{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricardojuanmorales.github.io/educacion-general-ia-accion-1/contenido/esquemas/glosario.schema.json",
  "title": "Glosario de EGIA Quest",
  "description": "Cada entrada lleva definición breve, definición operativa y distinción, siguiendo el método del glosario canónico de AI StoryLab.",
  "type": "object",
  "required": ["schema_version", "estado", "fecha", "terminos"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "egia-quest.contenido.glosario.v0.1.0" },
    "estado": { "type": "string", "minLength": 1 },
    "fecha": { "type": "string", "format": "date" },
    "sirve_a": { "type": "string" },
    "subjetividad_estrategica": { "type": "string" },
    "nota_autoria": { "type": "string" },
    "metodo": { "type": "string" },
    "terminos": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/termino" } }
  },
  "$defs": {
    "termino": {
      "type": "object",
      "additionalProperties": false,
      "required": ["termino", "definicion_breve", "definicion_operativa", "distincion", "fuente"],
      "properties": {
        "termino": { "type": "string", "minLength": 2, "maxLength": 50 },
        "definicion_breve": { "type": "string", "minLength": 20, "maxLength": 200 },
        "definicion_operativa": { "type": "string", "minLength": 40 },
        "distincion": {
          "description": "Qué NO es. Evita el uso decorativo del término.",
          "type": "string",
          "minLength": 30
        },
        "relacionados": { "type": "array", "items": { "type": "string" } },
        "fuente": { "type": "string", "minLength": 5 },
        "nota_pendiente": { "type": "string" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-storylab.local/schemas/export-package/0.8.0-alpha.2",
  "title": "AI StoryLab ExportPackage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exportType",
    "schemaVersion",
    "exportedAt",
    "project"
  ],
  "properties": {
    "exportType": {
      "const": "storylab_project"
    },
    "schemaVersion": {
      "const": "0.8.0-alpha.2"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "project": {
      "$ref": "https://ai-storylab.local/schemas/project/0.8.0-alpha.2"
    }
  }
}
